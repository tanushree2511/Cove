{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VisionArchive AI",
  "version": "1.0.0",
  "identifier": "com.visionarchive.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VisionArchive AI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/cove-backend",
      "bin/video-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first AI photo and video manager",
    "longDescription": "VisionArchive AI is a fully local, privacy-first photo and video manager with AI-powered face clustering and semantic search.",
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "libgl1", "libglib2.0-0"]
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
