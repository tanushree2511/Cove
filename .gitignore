docker-compose.override.yml

# --- Python (cove/, videoModules/) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / React frontend ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Data & model artifacts ---
# ML models, embeddings, and vector indexes are large binaries and
# should not be committed; fetch/generate them via download_models.py etc.
cove/models/*.onnx
cove/models/*.pt
cove/models/*.pth
*.onnx
*.npy
*.npz
*.pkl

# Databases / vector stores generated at runtime
*.db
*.sqlite
*.sqlite3

# Media assets ingested/produced by the pipelines
*.mp4
*.avi
*.mov
*.mkv
uploads/
media/
known_faces/

# --- Logs ---
*.log
logs/

# --- Env / secrets ---
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
MajorProject/

cove/test_images/
cove/test_images_full_backup/
test_images/

videoModules/bulk_import/*
!videoModules/bulk_import/.gitkeep

cove2/*
.claude/
